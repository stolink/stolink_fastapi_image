# StoLink Image Worker - Environment Variables Example
# 이 파일을 .env로 복사한 후 값을 입력하세요.
# cp .env.example .env

# =============================================================================
# Application
# =============================================================================
APP_NAME=StoLink Image Worker
DEBUG=true

# =============================================================================
# AWS S3 Configuration
# EC2 IAM Role 사용 시 ACCESS_KEY/SECRET_KEY 비워도 됨
# 로컬 개발 시 MinIO 사용: docker-compose-local.yml 참고
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=stolink-media-dev-seoul
AWS_S3_REGION=ap-northeast-2
S3_ENDPOINT_URL=http://minio:9000
CLOUDFRONT_URL=https://d3bjnp58mvtfd4.cloudfront.net

# =============================================================================
# AWS Bedrock Configuration (이미지 생성용 - 필수)
# =============================================================================
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_DEFAULT_REGION=us-east-1

# =============================================================================
# Google Gemini Configuration (이미지 편집용 - 필수)
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# RabbitMQ Configuration (필수)
# 로컬: localhost / 운영: Private IP
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=stolink
RABBITMQ_IMAGE_QUEUE=stolink.image.queue
